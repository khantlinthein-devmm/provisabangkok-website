# Contact form email (Hostinger). Copy to .env.local and fill in the mailbox password.
SMTP_USER=support@provisabangkok.com
SMTP_PASS=
# Optional, these are the defaults:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# CONTACT_TO=support@provisabangkok.com

# Blog editor (Keystatic) — created by the GitHub App setup, see README.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
